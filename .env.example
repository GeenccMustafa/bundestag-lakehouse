# Copy to .env and replace every value. .env is git-ignored; never commit it.
#   cp .env.example .env

# --- Airflow ---------------------------------------------------------------
# Your host user id so files in airflow/ aren't owned by root (`id -u`). 50000 is fine on macOS.
AIRFLOW_UID=50000
# Encrypts connections/variables in the metadata DB. Generate with:
#   uv run --with cryptography python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me
# Signs tokens between Airflow components. Generate with: openssl rand -hex 32
AIRFLOW_JWT_SECRET=change-me
# Login for the Airflow UI at http://localhost:8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Postgres (Airflow metadata DB) ---------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- DuckLake catalog (Silver/Gold table metadata, in the same Postgres) -----
# Separate role and database from Airflow's. Reachable from the host on localhost:5433.
DUCKLAKE_PG_USER=ducklake
DUCKLAKE_PG_PASSWORD=change-me
DUCKLAKE_PG_DB=ducklake

# --- pgAdmin (Postgres web UI at http://localhost:5050) -------------------------
# Runs in desktop mode (no login screen); pgAdmin still requires an initial password.
PGADMIN_DEFAULT_PASSWORD=change-me

# --- RustFS (S3-compatible object store, console at http://localhost:9001) -
RUSTFS_ACCESS_KEY=change-me
# At least 8 characters. Generate with: openssl rand -hex 20
RUSTFS_SECRET_KEY=change-me

# --- DIP API (Phase 1) -----------------------------------------------------
# Public key from https://dip.bundestag.de/über-dip/hilfe/api (it expires periodically).
DIP_API_KEY=

# --- dbt (Phase 2) -----------------------------------------------------------
# Lets `uv run --env-file .env dbt <cmd>` work from the repo root.
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt
